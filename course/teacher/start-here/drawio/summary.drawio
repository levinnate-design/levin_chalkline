        <mxCell id="e12" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#52606D;strokeWidth=2;" edge="1" parent="1" source="mo" target="mozi">
