{
  // Shortcuts for common commands.
  // Run one with:  Terminal menu > Run Task...  (or Ctrl/Cmd+Shift+P, then "Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Render: student",
      "type": "shell",
      "command": "quarto render",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Render: teacher",
      "type": "shell",
      "command": "quarto render --profile teacher",
      "group": "build",
      "problemMatcher": []
    },
    {
      // Runs before the preview: a full build if anything changed since the last one, so pages open fast.
      "label": "Build site if needed",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python chalkline.py build --profile teacher",
      "options": { "env": { "QUARTO_PYTHON": "${workspaceFolder}/.venv/bin/python" } },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe chalkline.py build --profile teacher",
        "options": { "env": { "QUARTO_PYTHON": "${workspaceFolder}\\.venv\\Scripts\\python.exe" } }
      },
      "problemMatcher": []
    },
    {
      // Starts by itself when you open this folder (VS Code asks once: "Allow automatic tasks").
      // The teacher version (answer keys and notes) at http://localhost:4100 (port set in _quarto.yml).
      "label": "Preview site (live reload)",
      "type": "shell",
      "command": "quarto preview --profile teacher",
      "options": { "env": { "QUARTO_PYTHON": "${workspaceFolder}/.venv/bin/python" } },
      "windows": { "options": { "env": { "QUARTO_PYTHON": "${workspaceFolder}\\.venv\\Scripts\\python.exe" } } },
      "isBackground": true,
      "dependsOn": "Build site if needed",
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    },
    {
      // Builds the student site (no answer keys) if anything changed, then serves it at http://localhost:4101
      "label": "Open student site",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python chalkline.py open student",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe chalkline.py open student" },
      "options": { "env": { "QUARTO_PYTHON": "${workspaceFolder}/.venv/bin/python" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Export vocab (Quizlet, Kahoot, Anki)",
      "type": "shell",
      "command": "python chalkline.py export-vocab",
      "problemMatcher": []
    },
    {
      // Asks for the kind (slides, worksheet...), the unit and the title, then makes the file from a template.
      "label": "New slide deck or worksheet",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python chalkline.py new ${input:newKind} ${input:newUnit} \"${input:newTitle}\"",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe chalkline.py new ${input:newKind} ${input:newUnit} \"${input:newTitle}\"" },
      "problemMatcher": []
    },
    {
      "label": "Check the vocab list",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python chalkline.py validate",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe chalkline.py validate" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "newKind", "type": "pickString", "description": "What kind of file?", "options": ["slides", "worksheet"], "default": "slides" },
    { "id": "newUnit", "type": "promptString", "description": "Which unit? (its number, like 2)" },
    { "id": "newTitle", "type": "promptString", "description": "Title (the file name comes from it)" }
  ]
}
