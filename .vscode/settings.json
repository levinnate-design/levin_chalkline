{
  // Run Python cells from the repo root, the same way `quarto render` does
  // (matches `execute-dir: project` in _quarto.yml).
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  // Turn on the project's .venv automatically in new terminals.
  "python.terminal.activateEnvironment": true,

  // Lesson files (.qmd) open in Quarto's visual editor: headings, bold and lists look like a document.
  // To see the plain text: Ctrl+Shift+F4 (Mac: Cmd+Shift+F4), or right-click the file > Edit in Source Mode.
  "workbench.editorAssociations": {
    "*.qmd": "quarto.visualEditor"
  },

  // Wrap long lines of prose instead of scrolling sideways.
  "[quarto]": {
    "editor.wordWrap": "on"
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },

  // Hide build output from the file list and search results.
  "files.exclude": {
    "**/.quarto": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "_site": true,
    "_site-teacher": true,
    ".venv": true,
    "exports": true
  }
}
